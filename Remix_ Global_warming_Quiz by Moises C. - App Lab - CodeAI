.progress-bubble.enabled { transition: background-color 0.2s ease-out, border-color 0.2s ease-out, color 0.2s ease-out; }

.progress-bubble.enabled:hover { text-decoration: none; }

.progress-bubble.enabled.hover-not-started:hover { border-color: var(--border-neutral-secondary) !important; background-color: var(--background-neutral-tertiary) !important; }

.progress-bubble.enabled.hover-in-progress:hover { border-color: var(--border-success-strong) !important; background-color: var(--background-success-light) !important; }

.progress-bubble.enabled.hover-completed:hover { color: var(--text-neutral-inverse) !important; border-color: var(--background-success-strong) !important; background-color: var(--background-success-strong) !important; }

.progress-bubble.enabled.hover-rejected:hover { color: var(--text-neutral-inverse) !important; border-color: var(--background-error-strong) !important; background-color: var(--background-error-strong) !important; }

.uitest-ProgressPill:focus-visible { outline-offset: 1px; }

a.progress-bubble-link { display: inline-block; cursor: pointer; text-decoration: none !important; }

a.progress-bubble-link:hover { text-decoration: none; }

a.progress-bubble-link:focus { outline: none; }

a.progress-bubble-link:focus-visible { outline: revert; }

table.progress-legend { margin-top: 60px; margin-bottom: 20px; }

table.progress-legend:nth-of-type(2) { margin-top: 0px; }

table.progress-legend:only-of-type { width: 100%; }

.progress-legend { text-align: center; color: var(--text-neutral-primary); font-weight: 400; }

.progress-legend td { padding: 10px; }

.progress-legend tr { border: 2px solid var(--borders-neutral-primary); background-color: var(--background-neutral-primary); }

.progress-legend thead tr { background-color: var(--background-neutral-secondary); }

.progress-legend thead tr:first-of-type { background-color: var(--background-neutral-primary); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.progress-legend thead tr:first-of-type td { font-weight: 600; font-size: 18px; }

.progress-legend thead tr div:nth-of-type(2) { font-size: 10px; }

.progress-legend tbody td:first-of-type { border-inline-end: 2px solid var(--borders-neutral-primary); }

.progress-legend div { display: flex; align-items: center; justify-content: center; }

.progress-legend .level-details { padding: 10px 0px; white-space: nowrap; }

.progress-legend .level-details div:nth-of-type(2) { padding-top: 16px; }

.progress-legend .level-details i { margin-inline-end: 5px; }

.progress-legend .end-border { border-inline-end: 2px solid var(--borders-neutral-primary); }
